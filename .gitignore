# ============================================================================
# JUCE Project .gitignore
# ============================================================================

# Build folders - these are gen by the IDE
Builds/
builds/
DerivedData/

# IDE-specific folders and files (we dont need these in the repo)
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/.gitignore
.idea/Project1.iml
.idea/customTargets.xml
.idea/editor.xml
.idea/modules.xml
.idea/vcs.xml

# Visual Studio specific files
*.opensdf
*.sdf
*.db
*.opendb
*.VC.db
*.VC.VC.opendb
ipch/
x64/
x86/
Debug/
Release/
*.ilk
*.pdb
*.exp
*.lib
*.map

# Xcode specific files
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# macOS specific files
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows specific files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux specific files (tip my fedora friends)
*~
.directory
*.elf

# CLion / JetBrains IDE
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
cmake-build-*/

# CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake

# JuceLibraryCode - Auto-generated
JuceLibraryCode/

# Compiled Object files
*.o
*.obj
*.lo
*.slo
*.ko

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a

# Executables
*.exe
*.out
*.app

# Binary folders
bin/
obj/

# Audio plugin build artifacts
*.vst
*.vst3
*.component
*.aaxplugin

# Temporary files
*.tmp
*.bak
*.swp
*.log